{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Event log record",
  "description": "One line of a run's event log, runs/<run_id>/events.jsonl (CONTRACT.md v0.6 §12). Each line is the record's canonical JSON (§4). The log writer stamps record_id, utc, met_s and prev_hash, and rewrites the head file beside the log, events.head, after every record (the Director's ruling on U23, 26 October 2026). Only the harness and BALDUR-0 write the log; ODIN's records arrive through POST /log/agent and POST /report (§8.3). Who writes each type (the Director's ruling on U21): the harness RUN_START, CONTACT, TRIGGER, CHECK_IN, REVOKE, TOOL_USE and RUN_END; BALDUR-0 PLAN_CHAIN_VERIFIED, ARMING_VERIFIED, PLAN_IN_FORCE, REQUEST, DECISION, DECISION_VOIDED, DISPATCH, OUTCOME, ESCALATION and RESTORE; ODIN AGENT_INPUT, MODEL_CALL, CANDIDATE, ANSWER, MALFORMED, SPEND and SPEND_STOP through POST /log/agent, and REPORT through POST /report. Fault onsets and the simulator's true state never go here: they go to the run's truth file, which ODIN never reads.",
  "type": "object",
  "required": ["record_id", "utc", "met_s", "type", "body", "prev_hash"],
  "additionalProperties": false,
  "properties": {
    "record_id": {"description": "Counts from 1 within the log (§4).", "$ref": "common.schema.json#/definitions/count_from_1"},
    "utc": {"$ref": "common.schema.json#/definitions/utc"},
    "met_s": {"$ref": "common.schema.json#/definitions/met_s"},
    "type": {"enum": [
      "RUN_START", "PLAN_CHAIN_VERIFIED", "ARMING_VERIFIED", "PLAN_IN_FORCE", "CONTACT", "TRIGGER",
      "AGENT_INPUT", "MODEL_CALL", "CANDIDATE", "ANSWER", "MALFORMED", "REQUEST", "DECISION",
      "DECISION_VOIDED", "DISPATCH", "OUTCOME", "ESCALATION", "REPORT", "CHECK_IN", "REVOKE",
      "RESTORE", "SPEND", "SPEND_STOP", "TOOL_USE", "RUN_END"
    ]},
    "body": {"type": "object"},
    "prev_hash": {
      "description": "The hash of the previous record's canonical JSON; null on the first record, whose previous record does not exist (§16 U15).",
      "anyOf": [{"$ref": "common.schema.json#/definitions/sha256"}, {"type": "null"}]
    }
  },
  "allOf": [
    {"if": {"required": ["record_id"], "properties": {"record_id": {"const": 1}}},
     "then": {"properties": {"prev_hash": {"type": "null"}}},
     "else": {"properties": {"prev_hash": {"$ref": "common.schema.json#/definitions/sha256"}}}},
    {"if": {"required": ["type"], "properties": {"type": {"const": "AGENT_INPUT"}}},
     "then": {"properties": {"body": {"$ref": "agent_input.schema.json"}}}},
    {"if": {"required": ["type"], "properties": {"type": {"const": "MODEL_CALL"}}},
     "then": {"properties": {"body": {"$ref": "model_call.schema.json"}}}},
    {"if": {"required": ["type"], "properties": {"type": {"const": "CANDIDATE"}}},
     "then": {"properties": {"body": {"$ref": "candidate.schema.json"}}}},
    {"if": {"required": ["type"], "properties": {"type": {"const": "ANSWER"}}},
     "then": {"properties": {"body": {"$ref": "answer_record.schema.json"}}}},
    {"if": {"required": ["type"], "properties": {"type": {"const": "MALFORMED"}}},
     "then": {"properties": {"body": {"$ref": "malformed.schema.json"}}}},
    {"if": {"required": ["type"], "properties": {"type": {"const": "REQUEST"}}},
     "then": {"properties": {"body": {"description": "The COMMAND_REQUEST as received (§8.2).", "$ref": "command_request.schema.json"}}}},
    {"if": {"required": ["type"], "properties": {"type": {"const": "DECISION"}}},
     "then": {"properties": {"body": {"description": "The decision record (§9.1 RECORD, §9.2).", "$ref": "decision_record.schema.json"}}}},
    {"if": {"required": ["type"], "properties": {"type": {"const": "DECISION_VOIDED"}}},
     "then": {"properties": {"body": {"$ref": "decision_voided.schema.json"}}}},
    {"if": {"required": ["type"], "properties": {"type": {"const": "DISPATCH"}}},
     "then": {"properties": {"body": {"$ref": "dispatch.schema.json"}}}},
    {"if": {"required": ["type"], "properties": {"type": {"const": "OUTCOME"}}},
     "then": {"properties": {"body": {"$ref": "outcome.schema.json"}}}},
    {"if": {"required": ["type"], "properties": {"type": {"const": "ESCALATION"}}},
     "then": {"properties": {"body": {"description": "The body of POST /escalation as received (§8.2).", "$ref": "escalation.schema.json"}}}},
    {"if": {"required": ["type"], "properties": {"type": {"const": "REPORT"}}},
     "then": {"properties": {"body": {"description": "The report as filed with POST /report (§8.3).", "$ref": "report.schema.json"}}}},
    {"if": {"required": ["type"], "properties": {"type": {"const": "CHECK_IN"}}},
     "then": {"properties": {"body": {"description": "The check-in as delivered to POST /checkin (A-1).", "$ref": "checkin.schema.json"}}}},
    {"if": {"required": ["type"], "properties": {"type": {"const": "TOOL_USE"}}},
     "then": {"properties": {"body": {"$ref": "tool_use.schema.json"}}}},
    {"if": {"required": ["type"], "properties": {"type": {"const": "RUN_START"}}},
     "then": {"properties": {"body": {"$ref": "run_start.schema.json"}}}},
    {"if": {"required": ["type"], "properties": {"type": {"const": "PLAN_CHAIN_VERIFIED"}}},
     "then": {"properties": {"body": {"$ref": "plan_chain_verified.schema.json"}}}},
    {"if": {"required": ["type"], "properties": {"type": {"const": "ARMING_VERIFIED"}}},
     "then": {"properties": {"body": {"$ref": "arming_verified.schema.json"}}}},
    {"if": {"required": ["type"], "properties": {"type": {"const": "PLAN_IN_FORCE"}}},
     "then": {"properties": {"body": {"$ref": "plan_in_force.schema.json"}}}},
    {"if": {"required": ["type"], "properties": {"type": {"const": "CONTACT"}}},
     "then": {"properties": {"body": {"$ref": "contact.schema.json"}}}},
    {"if": {"required": ["type"], "properties": {"type": {"const": "TRIGGER"}}},
     "then": {"properties": {"body": {"$ref": "trigger_record.schema.json"}}}},
    {"if": {"required": ["type"], "properties": {"type": {"const": "REVOKE"}}},
     "then": {"properties": {"body": {"$ref": "revoke.schema.json"}}}},
    {"if": {"required": ["type"], "properties": {"type": {"const": "RESTORE"}}},
     "then": {"properties": {"body": {"$ref": "restore_record.schema.json"}}}},
    {"if": {"required": ["type"], "properties": {"type": {"const": "SPEND"}}},
     "then": {"properties": {"body": {"$ref": "spend.schema.json"}}}},
    {"if": {"required": ["type"], "properties": {"type": {"const": "SPEND_STOP"}}},
     "then": {"properties": {"body": {"$ref": "spend_stop.schema.json"}}}},
    {"if": {"required": ["type"], "properties": {"type": {"const": "RUN_END"}}},
     "then": {"properties": {"body": {"$ref": "run_end.schema.json"}}}}
  ]
}

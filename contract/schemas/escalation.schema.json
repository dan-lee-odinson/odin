{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Escalation",
  "description": "The body of POST /escalation: the model's escalation (answer.schema.json) plus the fields the loop fills in (CONTRACT.md v0.6 §7.1, §8.2, §16.5 U17). Escalations carry no authority and are not signed.",
  "type": "object",
  "required": [
    "kind", "escalation_kind", "refs", "proposed", "urgency",
    "run_id", "turn_id", "met_s", "utc", "plan_id", "agent_input_hash"
  ],
  "additionalProperties": false,
  "properties": {
    "kind": {"$ref": "answer.schema.json#/definitions/escalation/properties/kind"},
    "escalation_kind": {"$ref": "answer.schema.json#/definitions/escalation/properties/escalation_kind"},
    "refs": {"$ref": "answer.schema.json#/definitions/escalation/properties/refs"},
    "proposed": {"$ref": "answer.schema.json#/definitions/escalation/properties/proposed"},
    "urgency": {"$ref": "answer.schema.json#/definitions/escalation/properties/urgency"},
    "rationale": {"$ref": "answer.schema.json#/definitions/rationale"},
    "run_id": {"$ref": "common.schema.json#/definitions/identifier"},
    "turn_id": {"$ref": "common.schema.json#/definitions/count_from_1"},
    "met_s": {"$ref": "common.schema.json#/definitions/met_s"},
    "utc": {"$ref": "common.schema.json#/definitions/utc"},
    "plan_id": {
      "description": "The plan in force; null when none is.",
      "anyOf": [{"$ref": "common.schema.json#/definitions/identifier"}, {"type": "null"}]
    },
    "agent_input_hash": {"description": "As in a command request: the SHA-256 of the exact turn-bundle bytes the harness served.", "$ref": "command_request.schema.json#/properties/agent_input_hash"}
  }
}
